{
  "name": "chameleon-bg",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "content:fetch": "python scripts/fetch-sources.py",
    "content:build": "python scripts/build-corpus.py && python scripts/import-reverse-dictionary.py && python scripts/merge-reverse-dictionary.py && npm run content:enrich",
    "audio:texts": "tsx scripts/export-audio.ts",
    "content:check": "tsx scripts/validate-content.ts",
    "content:enrich": "python scripts/import-verb-paradigms.py && python scripts/fix-verb-paradigms.py && tsx scripts/export-professional-contexts.ts && python scripts/enrich-contexts.py && tsx scripts/export-rail-dialogues.ts && python scripts/add-editorial-examples.py",
    "audio:index": "python scripts/index-audio.py",
    "audio:generate": ".venv/bin/python scripts/generate-audio.py && python scripts/index-audio.py",
    "learning:audit": "tsx scripts/audit-learning.ts",
    "learning:check": "tsx scripts/check-exercises.ts",
    "performance:bench": "tsx scripts/benchmark-performance.ts",
    "build:profile": "tsc -b && CHAMELEON_PROFILE=1 vite build",
    "photos:responsive": "python scripts/responsive-photos.py"
  },
  "dependencies": {
    "dexie": "^4.2.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ts-fsrs": "^5.2.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^5.0.5"
  }
}
