ва, което искаше":"e26f220c","не разполагаме с толкова време":"f0636350","=том вероятно ще бъде изписан от болницата утре":"27d07279","абсолютно сигурен съм, че том греши":"8c645491","коя е приятелката на том":"f4fd2c83","=трябва да си внимателна":"abf759b0","=обичам да правя снимки":"ee26340b","аз притежавам това място":"699159b8","=том си изплю дъвката":"6d543d5f","=не съм неин тип":"a2b789ce","качеството на ориза се влошава":"13789a93","том е буден":"77fa8a14","=ето къде си":"2518fffe","това не е твоята битка":"73ca2f50","има някой в къщата":"18dbfeb5","моят най-добър приятел е една книга":"bd628349","трябва да ви поздравя":"a5920b76","=придържай се към фактите":"1ec0a2ae","=живял някога един цар в един стар замък":"8c6a762c","=колко е този чадър":"5284d8c0","вчера беше хубав ден":"39232df1","работя като музейна служителка":"076919b5","къде беше онова":"5395b3a9","не знам как да помогна на том":"fdb343db","за мен е чест да бъда тук":"08028388","=колко багаж имаш":"fd12904f","нямам никакъв контрол върху това, което се случва":"ebf67275","=листата паднаха на земята":"9b8f72e6","=чаят струва две евро":"47d27049","=никой освен том не го знаеше":"cbc63411","джебчии преследват туристи":"d1784a2b","=тук няма книги на руски, да отидем в друг магазин в центъра на града":"2b1487f7","=гласувай за мен":"8e027e1e","аз съм шпионин":"d58602fe","исландия е остров":"6c1ed76d","=анги́на":"6e89c269","=би́вам":"c308c133","=бръшля́н":"e682d2c2","=да́нък":"fa9c882f","=дюше́к":"3c5b4e63","=ме́сец":"80314e1b","=пащърна́к":"c171172d","=помия́р":"b86fb1e0","=простра́нство":"a3c70cea","=противоконституцио́нен":"c6ccfe43","=раня́":"34fa2954","=стража́р":"c0221a55","=це́зий":"c863335b","няма да пиша":"2f980e62","=ще е ли писала":"42dfaebd","=нямаше да е работило":"bb36e8c7","=беше ли чела":"e47c4c87","=няма да съм чело":"3abf74cf","=агонизират":"0f23eb2a","=актуализира":"0ead5ce0","=актуализирала":"052e6763","бесехте":"2f99273d","=благодарихте":"73944a80","браниш":"2f0b760b","бранят":"2f3657